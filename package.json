{
  "name": "dofusmirror",
  "version": "0.1.0",
  "description": "Cross-platform Android screen mirroring and control",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && npm run build:renderer",
    "clean": "rm -rf dist",
    "build:native": "cd native && node-gyp rebuild",
    "start": "npm run build && electron .",
    "dev": "tsc -p tsconfig.json && electron .",
    "fetch:platform-tools": "node scripts/fetch-platform-tools.mjs",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "build:main": "tsc -p tsconfig.json && node scripts/copy-assets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^38.0.0",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  }
}