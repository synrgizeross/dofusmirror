{
  "name": "dofusmirror",
  "version": "0.1.0",
  "description": "Mirror and control Dofus Touch from your desktop",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && npm run build:renderer",
    "clean": "rm -rf dist release",
    "build:native": "cd native && node-gyp rebuild",
    "start": "npm run build && electron .",
    "dev": "tsc -p tsconfig.json && electron .",
    "fetch:platform-tools": "node scripts/fetch-platform-tools.mjs",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "build:main": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "prebuild": "node scripts/ensure-platform-tools.mjs",
    "prepack": "node scripts/ensure-platform-tools.mjs",
    "predist": "node scripts/ensure-platform-tools.mjs",
    "predist:win": "node scripts/ensure-platform-tools.mjs",
    "predist:mac": "node scripts/ensure-platform-tools.mjs",
    "predist:linux": "node scripts/ensure-platform-tools.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "radix-ui": "^1.7.0",
    "lucide-react": "^1.55.0",
    "shadcn": "^4.21.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "tw-animate-css": "^1.4.0",
    "@fontsource-variable/geist": "^5.3.0"
  },
  "productName": "DofusMirror",
  "build": {
    "appId": "com.dofusmirror.app",
    "productName": "DofusMirror",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist",
      "!dist/win-unpacked/**",
      "!dist/mac*/**",
      "!dist/builder-debug.yml",
      "assets/engine.jar"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "identity": null,
      "files": [
        "dist",
        "!dist/win-unpacked/**",
        "!dist/mac*/**",
        "!dist/builder-debug.yml",
        "assets/engine.jar",
        "assets/platform-tools/darwin/**/*"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "files": [
        "dist",
        "!dist/win-unpacked/**",
        "!dist/mac*/**",
        "!dist/builder-debug.yml",
        "assets/engine.jar",
        "assets/platform-tools/windows/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Mirror and control Dofus Touch from your desktop",
      "files": [
        "dist",
        "!dist/win-unpacked/**",
        "!dist/mac*/**",
        "!dist/builder-debug.yml",
        "assets/engine.jar",
        "assets/platform-tools/linux/**/*"
      ]
    },
    "electronLanguages": [
      "en"
    ]
  },
  "author": {
    "name": "DofusMirror",
    "email": "support@dofusmirror.com"
  }
}
